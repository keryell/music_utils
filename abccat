#!/usr/bin/env python3

"""Concatenate ABC tunes into a single multi-part tune.

This tool reads one or more ABC music files, each containing
individual tunes (identified by X: headers), and merges them into a
single composite tune.  The first P: (part order) header of each input
tune is collected to build a global play-order string that describes
how all the parts should be played in sequence.

Most per-tune headers are handled to maximize compatibility with both
abcm2ps (visual rendering) and abc2midi (MIDI output):

- ``T:`` (title) is always kept as an active header since abc2midi
  accepts it in the tune body and emits it as a MIDI sequence_name
  meta-event.
- ``C:`` (composer) and ``R:`` (rhythm) are kept as active headers
  for the first tune (they are valid in the ABC header before ``K:``),
  but demoted to ``%%text`` comments for subsequent tunes since
  abc2midi rejects them in the body.
- ``X:`` (reference number) is always demoted since only one ``X:``
  is allowed per tune.
- Other per-tune headers (listed in UNIQUE_HEADERS) are demoted to
  ``%%text`` comments so they remain visible in print but do not
  interfere with the merged output.

An optional ``%%abccat P:<value>`` directive in the input overrides the
automatically collected global P: header, while still showing the
original as a %%text annotation.

Usage::

    abccat tune1.abc tune2.abc > merged.abc
    cat tune1.abc tune2.abc | abccat > merged.abc
"""

import io
import re
import sys

# ABC headers that are only meaningful once per tune and cannot be
# meaningfully merged.  When concatenating, these are converted to
# %%text comments so they remain visible but do not interfere with
# the combined output.
# Note: T is excluded because abc2midi accepts it in the body
# (sequence_name meta-event).  C and R are excluded because they
# need special first-tune vs. subsequent-tune handling.
UNIQUE_HEADERS = set("ABDGHNOSZ")

# Fallback encoding when a file is not valid UTF-8 and no explicit
# ``%%encoding`` directive is present.  ISO-8859-15 (Latin-9) covers
# Western European languages and includes the euro sign and French
# œ/Œ that ISO-8859-1 lacks.
FALLBACK_ENCODING = "iso-8859-15"

# Matches an ABC ``%%encoding <charset>`` directive.  Only the first
# occurrence in the file is honored.  Example: ``%%encoding latin1``.
ENCODING_DIRECTIVE_RE = re.compile(
    rb"^%%encoding\s+(\S+)", re.MULTILINE
)

# Normalize a few ABC encoding aliases to Python codec names.
# ABC files in the wild commonly use bare names like ``latin1``
# which Python accepts, but some tools write ``native`` or similar
# non-standard values.
ENCODING_ALIASES = {
    "native": "utf-8",
}


def decode_bytes(raw):
    """Decode raw file bytes into a text string.

    Resolution order:
    1. If an ABC ``%%encoding`` directive is present in the file,
       use the charset it declares.  This lets the file itself
       document its encoding — most authoritative.
    2. Otherwise, try UTF-8.  Since valid Latin-9 that also happens
       to be valid UTF-8 is necessarily pure ASCII, the UTF-8 decode
       produces the same result in that case — lossless.
    3. On UTF-8 failure, fall back to ISO-8859-15 (Latin-9).
    """
    m = ENCODING_DIRECTIVE_RE.search(raw)
    if m:
        # The directive itself is pure ASCII, so decoding the match
        # as ASCII is safe regardless of the real file encoding.
        declared = m.group(1).decode("ascii").lower()
        codec = ENCODING_ALIASES.get(declared, declared)
        return raw.decode(codec)
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode(FALLBACK_ENCODING)


def read_file(path):
    """Read a file and return it as an in-memory text stream."""
    with open(path, "rb") as f:
        return io.StringIO(decode_bytes(f.read()))

# Headers that are valid in the ABC file header (before K:) but not
# in the tune body.  For the first tune they are kept as active
# headers; for subsequent tunes they are demoted to %%text.
FIRST_TUNE_ONLY_HEADERS = set("CR")


def main():
    # Whether we are still processing the very first tune
    first_tune = True
    # Set to True once at least one X: header has been seen
    a_tune_has_been_found = False
    # Accumulated P: parts from each tune's first P: header
    global_p_header = ""
    # Explicit override from a %%abccat P: directive, if any
    abccat_p_header = None
    # All body output is buffered so the global header can be
    # emitted first
    output_buffer = ""
    # Tracks whether the first P: of the current tune has been seen
    p_header_found = False

    def output(s):
        """Append a string to the output buffer."""
        nonlocal output_buffer
        output_buffer += s

    def output_header(header, content):
        """Append an ABC header line (e.g. ``M:4/4``) to the output."""
        output(f"{header}:{content}\n")

    def output_as_text(s):
        """Append a string as a ``%%text`` comment line."""
        output(f"%%text {s}")

    def output_header_as_text(header, content):
        """Append an ABC header as a ``%%text`` comment."""
        output_as_text(f"{header}:{content}\n")

    def deal_with_header(header, content):
        """Process a single ABC header field.

        - ``X:`` marks the start of a new tune: reset per-tune state
          and emit the original reference number as a text comment.
        - The first ``P:`` of each tune contributes to the global
          play-order; subsequent ``P:`` headers (part labels within the
          tune body) are kept as active headers.
        - ``T:`` is always kept as an active header (abc2midi accepts
          it in the body and emits a MIDI sequence_name meta-event).
        - ``C:`` and ``R:`` are kept as active headers for the first
          tune (valid in the ABC header) but demoted to ``%%text``
          for subsequent tunes (abc2midi rejects them in the body).
        - Headers in UNIQUE_HEADERS are demoted to text comments since
          they cannot be combined across tunes.
        - All other headers (e.g. ``M:``, ``L:``, ``K:``, ``V:``,
          ``w:``) are passed through unchanged.
        """
        nonlocal first_tune, a_tune_has_been_found, global_p_header
        nonlocal p_header_found

        if header == "X":
            # Beginning of a new tune
            p_header_found = False
            if first_tune and a_tune_has_been_found:
                first_tune = False
            a_tune_has_been_found = True
            output_header_as_text(header, content)
        elif header == "P":
            if not p_header_found:
                # First P: of this tune defines its part order;
                # accumulate it into the global play-order string
                global_p_header += content
                p_header_found = True
                output_header_as_text(header, content)
            else:
                # Subsequent P: headers are part labels within
                # the tune body -- keep them active
                output_header(header, content)
        elif header in UNIQUE_HEADERS:
            # Per-tune-only headers: demote to text comments
            output_header_as_text(header, content)
        elif header in FIRST_TUNE_ONLY_HEADERS:
            # C: and R: are valid in the ABC header but not in
            # the body -- keep them active for the first tune,
            # demote to %%text for subsequent tunes
            if first_tune:
                output_header(header, content)
            else:
                output_header_as_text(header, content)
        else:
            # Mergeable headers (M:, L:, K:, V:, T:, etc.):
            # pass through as-is
            output_header(header, content)

    def abccat(f):
        """Parse an ABC file and process its headers and body lines.

        Handles continuation lines (ending with ``\\``) by
        accumulating them before processing.  Recognizes the special
        ``%%abccat P:`` directive to override the global part order.
        Blank lines are silently discarded.
        """
        nonlocal abccat_p_header
        line = ""
        for raw in f:
            raw = raw.rstrip("\n\r")
            line += raw

            m = re.match(r"^\s*([A-Z]):(.*)", line)
            if m:
                header, content = m.group(1), m.group(2)
                if line.endswith("\\"):
                    # Continuation line: keep accumulating
                    line += "\n"
                    continue
                deal_with_header(header, content)
            elif (m := re.match(r"^%%abccat\sP:(.*)$", line)):
                # Explicit override for the global P: header
                print(f"Define an explicit global P:{m.group(1)}",
                      file=sys.stderr)
                abccat_p_header = m.group(1)
            elif re.match(r"^\s*$", line):
                pass  # Blank line -- discard
            else:
                # Music body or other non-header content
                output(f"{line}\n")

            line = ""

    # Process input from stdin or from files given as arguments
    if len(sys.argv) <= 1:
        # Read stdin as bytes so the same encoding detection (and
        # ``%%encoding`` directive handling) applies as for files
        abccat(io.StringIO(decode_bytes(sys.stdin.buffer.read())))
    else:
        for filename in sys.argv[1:]:
            abccat(read_file(filename))

    # Emit the merged tune with a single X:1 header and the
    # combined (or overridden) P: play-order
    print("X:1")
    if abccat_p_header is not None:
        # An explicit %%abccat P: was given; use it but show the
        # automatically collected one as a text annotation
        print(f"P:{abccat_p_header}")
        print(f"%%text instead of P:{global_p_header}")
    else:
        print(f"P:{global_p_header}")
    print(output_buffer, end="")


if __name__ == "__main__":
    main()
